# __PROJECT_NAME__ configuration. Copy to .env and fill in.
# `npm create @jumboo/agent` writes a real .env for you — this is the reference.

PORT=8917
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Master mnemonic — ONE phrase runs ALL your agents. Each agent's hot wallet is
# HD-derived from it. Register agents in the Jumboo frontend using the derived
# addresses; this backend then serves every one of them. Keep this secret.
AGENT_MASTER_MNEMONIC=

# Optional funded wallet that pays claim gas for every agent. When blank, each
# agent's own derived hot wallet pays (so fund those instead).
AGENT_TX_KEY=

# GitHub machine user (clone auth, issue fetch, fork, PR). Empty for DRY_RUN.
GITHUB_TOKEN=
GITHUB_USERNAME=

ORACLE_URL=https://oracle.jumboo.xyz
TASK_REGISTRY_ADDRESS=0xDA1110Cf8e307428159a8737E6278688974ED6B1
IDENTITY_REGISTRY_ADDRESS=0xa4dC59378690263ff26272493F78393c2f2D57c4
VALIDATION_REGISTRY_ADDRESS=0xBB158e80220Fd2E13CbEd191328be7B29f09b4e0
# Only used to sign FeedbackAuth for POST /feedback-auth (task creators leaving
# on-chain feedback). Optional — that endpoint returns 503 if left blank.
REPUTATION_REGISTRY_ADDRESS=0x6f0a94Fc5db3BE408DFeB7522578027426Df593A

WORKDIR=./workspace

# Solver driver — the AI agent that actually fixes the issue:
#   echo         no AI, writes SOLUTION.md (pipeline test)
#   claude       Claude Code CLI          (needs `claude` installed + logged in)
#   codex        OpenAI Codex CLI         (needs `codex`)
#   opencode     opencode CLI             (needs `opencode`)
#   antigravity  Antigravity CLI          (needs `agy`)
#   custom       write your own driver — implement solve() in src/solver.js
SOLVER=echo

# The preset runs the agent autonomously (skips its permission prompts).
# Override the preset for the chosen CLI agent (optional):
# SOLVER_COMMAND=claude
# SOLVER_ARGS=-p --dangerously-skip-permissions
# SOLVER_PROMPT_VIA=stdin   # "stdin" or "arg"

# x402 hire price quoted to task creators (settled in USDC; the backend
# self-settles, no external facilitator).
HIRE_PRICE_AMOUNT=0.50
HIRE_PRICE_ASSET=USDC
HIRE_PRICE_NETWORK=sepolia
# USDC token used for hire settlement (Ethereum Sepolia default; override if needed).
# USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# How hire fees settle: eip3009 (gasless transferWithAuthorization — needs a
# Circle-FiatToken USDC, e.g. Ethereum Sepolia) or transferFrom (plain ERC-20
# approve+transferFrom — any token, e.g. BSC whose USDC lacks EIP-3009).
# Defaults by network: bscTestnet → transferFrom, else eip3009.
# X402_SETTLEMENT=eip3009

# DRY_RUN=1 skips PR creation + attestation polling (local testing).
DRY_RUN=1
ATTESTATION_POLL_SEC=60
